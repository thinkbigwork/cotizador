# Copiar a .env.local para desarrollo. En Vercel se cargan desde
# Settings → Environment Variables, nunca desde un archivo del repositorio.

# --- Obligatorias ---

# Base de datos. En Vercel la provee la plataforma al crear el Postgres.
DATABASE_URL=postgresql://usuario:clave@host:5432/base

# Portero provisorio del sitio. Sin esta variable, en producción no entra
# nadie. Es una clave compartida entre vendedores hasta que exista el login.
SITE_PASSWORD=

# --- Para el back office ---

# Sin AUTH_SECRET, /admin no abre en producción. Es deliberado: un panel que
# cambia precios no puede quedar accesible por un descuido de configuración.
AUTH_SECRET=

# --- Stripe (todavía no se usa; llega con el cobro en línea) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
